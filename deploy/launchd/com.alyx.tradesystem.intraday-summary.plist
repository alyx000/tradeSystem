<?xml version="1.0" encoding="UTF-8"?>
<!-- Sleep policy: 盘中扫描依赖 Mac 唤醒；错过 5 分钟槽位后不补发陈旧摘要。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alyx.tradesystem.intraday-summary</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/alyx/tradeSystem/deploy/launchd/intraday-summary-runner.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/tmp/tradesystem-intraday-summary.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/tradesystem-intraday-summary.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
